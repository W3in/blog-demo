# Copy this file to .env: cp .env.example .env
# Values below are for local development only. Never reuse them in production.

# PostgreSQL
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog_dev_password
POSTGRES_DB=blog_development
DATABASE_URL=postgresql://blog:blog_dev_password@db:5432/blog_development

# Backend (Rails)
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000

# Frontend (Nuxt) - address the browser uses to call the API
NUXT_PUBLIC_API_BASE=http://localhost:3001

# Your user id on Linux/macOS (run `id -u` and `id -g`). Containers run as this user
# so files they create belong to you, not root. 1000 is correct for most Linux setups.
UID=1000
GID=1000

# Host ports (change if one is already used on your machine)
FRONTEND_PORT=3000
BACKEND_PORT=3001
DB_PORT=5432
MAILPIT_UI_PORT=8025
